    // Process-specific resource requirements
    // TODO nf-core: Customise requirements for specific processes.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors

process {

    // Defaults applied to every process unless overridden below
    cpus   = { check_max( 1    * task.attempt, 'cpus'   ) }
    memory = { check_max( 50.MB * task.attempt, 'memory' ) }
    time   = { check_max( 1.h  * task.attempt, 'time'   ) }

    errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    withName: RUN_VEP {
        container = '/software/hgi/containers/vep/vep_115.2.sif' //{ params.vep_container }
//        containerOptions = {"--bind ${params.vep_data_dir}:/opt/vep/.vep"}
        memory = { check_max( 8.GB * (task.attempt ** 1.5), 'memory' ) }
        time   = { check_max( 72.h  * task.attempt, 'time'   ) }
    }

    // Same resource profile for every VCF-normalisation variant
    withName: 'NORM_VCF|NORM_VCF_WITH_G|NORM_VCF_LEFT_ALIGN|NORM_VCF_WITH_G_LEFT_ALIGN' {
        cpus   = { check_max( 4    * task.attempt, 'cpus'   ) }
        memory = { check_max( 2.GB * (task.attempt ** 1.5), 'memory' ) }
        time   = { check_max( 48.h  * task.attempt, 'time'   ) }
    }

    withName: NO_G_VCF {
        cpus   = { check_max( 10    * task.attempt, 'cpus'   ) }
        memory = { check_max( 300.MB * (task.attempt ** 1.5), 'memory' ) }
        time   = { check_max( 48.h    * task.attempt, 'time'   ) }
    }

    withName: SPLIT_VCF {
        memory = { check_max( 100.MB * (task.attempt ** 1.5), 'memory' ) }
        time   = { check_max( 48.h    * task.attempt, 'time'   ) }
    }

    withName: SPLIT_VCF_BED {
        memory = { check_max( 20.GB * (task.attempt ** 1.5), 'memory' ) }
    }

    withName: BCFTOOLS_SPLIT_VEP {
        memory = { check_max( 300.MB * (task.attempt ** 1.5), 'memory' ) }
    }

    withName: 'BGZIP2|BGZIP2_VEP' {
        publishDir = [
            path: params.publishdir,
            mode: 'copy',
            overwrite: true
        ]
    }
    // ---------------------------------------------------------------------
    // nf-core standard resource labels — reuse these on new modules where
    // possible instead of adding more withName blocks above.
    // ---------------------------------------------------------------------

    withLabel: process_low {
        cpus   = { check_max( 2    * task.attempt, 'cpus'   ) }
        memory = { check_max( 1.GB * task.attempt, 'memory' ) }
        time   = { check_max( 1.h   * task.attempt, 'time'   ) }
    }

    withLabel: process_medium {
        cpus   = { check_max( 4    * task.attempt, 'cpus'   ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time   = { check_max( 2.h   * task.attempt, 'time'   ) }
    }

    withLabel: process_high {
        cpus   = { check_max( 8     * task.attempt, 'cpus'   ) }
        memory = { check_max( 10.GB * task.attempt, 'memory' ) }
        time   = { check_max( 12.h   * task.attempt, 'time'   ) }
    }

    withLabel: process_long {
        time = { check_max( 20.h * task.attempt, 'time' ) }
    }

    withLabel: process_high_memory {
        memory = { check_max( 200.GB * task.attempt, 'memory' ) }
    }

    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }

    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}
