params {

    // =====================================================================
    // INPUT
    // =====================================================================
    // A single VCF file, or a folder containing multiple VCFs.
    // If input is a folder, only files ending in .vcf, .vcf.gz, .vcf.bgz,
    // .bcf, .bcf.gz, or .bcf.bgz are picked up — every other file in that
    // folder is ignored.
    input = ""

    // =====================================================================
    // SPLITTING A LARGE VCF
    // Splits each input VCF into smaller chunks so VEP annotation can run
    // in parallel across many jobs to speed up the annotation.
    // =====================================================================
    split_input      = false // true to split each input VCF into chunks before annotating
    number_of_chunks = 100   // how many chunks to split each VCF into (only used when split_input = true)

    // =====================================================================
    // RUN MODES
    // =====================================================================
    transcript_mode = "all"  // all | worst | primary | main — which transcript(s) VEP reports per variant
    annotate_vcf    = true   // produce a VEP-annotated VCF (CSQ added back into the original VCF)
    left_align      = false  // left-align/normalise indels before annotating (required if wxs_tsv = true)
    wxs_tsv        = false  // also produce a TSV formatted for WxS-QC pipeline (requires left_align = true)
    csq_tsv         = false  // also produce a single TSV combining every variant's CSQ annotation

    // =====================================================================
    // REQUIRED PATHS
    // =====================================================================
    ref_fasta  = "/lustre/scratch125/humgen/resources_v2/ref/Homo_sapiens/HS38DH/hs38DH.fa" // required if left_align = true
    // NOTE: `workdir` is informational only — it does not set Nextflow's actual
    // work directory. Use the `-w <path>` CLI flag (or a `workDir` setting in
    // nextflow.config) to control where Nextflow actually stores task data.
    workdir    = "${launchDir}/work"
    publishdir = "${launchDir}/results"  // where final results get copied to

    // =====================================================================
    // VEP RESOURCES
    // =====================================================================
    vep_data_dir    = "/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/vep_data"
    vep_plugins_dir = "/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins"
    vep_fasta       = "/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/vep_data/homo_sapiens/115_GRCh38/Homo_sapiens.GRCh38.dna.toplevel.fa.gz"
    assembly        = "GRCh38"

    // ---------------------------------------------------------------------
    // VEP PLUGINS — this is the value the pipeline actually uses.
    // Leave empty to run with no plugins, or paste in one or more
    // `--plugin ...` / `--custom ...` lines copied from `plugins_examples`
    // below (join multiple lines with a trailing backslash `\`, as shown
    // in the example).
    // ---------------------------------------------------------------------
    plugins = ""

    // ---------------------------------------------------------------------
    // plugins_examples — REFERENCE ONLY, not used by the pipeline.
    // The value below is never read by any process; it exists purely as a
    // menu of ready-to-use, correctly-formatted plugin invocations.
    // To enable a plugin: copy its line (or lines) from here and paste them
    // into `plugins` above.
    // ---------------------------------------------------------------------
    plugins_examples = """ \
    --plugin SpliceRegion,Extended \
    --custom /lustre/scratch125/humgen/resources_v2/ClinVar/clinvar_20260621.vcf.gz,ClinVar,vcf,exact,0,CLNDN,CLNDNINCL,CLNDISDB,CLNDISDBINCL,AF_ESP,AF_EXAC,AF_TGP,ALLELEID,CLNDN,CLNDNINCL,CLNDISDB,CLNDISDBINCL,CLNHGVS,CLNREVSTAT,CLNSIG,CLNSIGCONF,CLNSIGINCL,CLNVC,CLNVCSO,CLNVI,DBVARID,GENEINFO,MC,ORIGIN,RS,SSR \
    --plugin CADD,snv=/lustre/scratch125/humgen/resources_v2/cadd_scores/20240226-GRCh38_v1.7/whole_genome_SNVs.tsv.gz,indels=/lustre/scratch125/humgen/resources_v2/cadd_scores/20240226-GRCh38_v1.7/gnomad.genomes.r4.0.indel.tsv.gz \
    --plugin LoF,loftee_path:/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins,human_ancestor_fa:/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/human_ancestor.fa.gz,conservation_file:/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/loftee.sql,gerp_bigwig:/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/gerp_conservation_scores.homo_sapiens.GRCh38.bw \
    --plugin REVEL,file=/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/new_tabbed_revel_grch38.tsv.gz \
    --plugin SpliceAI,snv=/lustre/scratch125/humgen/resources_v2/SpliceAI_data_files/spliceai_scores.raw.snv.hg38.vcf.gz,indel=/lustre/scratch125/humgen/resources_v2/SpliceAI_data_files/spliceai_scores.raw.indel.hg38.vcf.gz \
    --plugin AncestralAllele,/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/homo_sapiens_ancestor_GRCh38.fa.gz \
    --plugin OpenTargets,file=/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/OTGenetics.tsv.gz,cols=all \
    --plugin LoFtool,/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/LoFtool_scores.txt \
    --plugin AlphaMissense,file=/lustre/scratch125/humgen/resources_v2/AlphaMissense/AlphaMissense_hg38.tsv.gz \
    --plugin UTRAnnotator,file=/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/uORF_5UTR_GRCh38_PUBLIC.txt \
    --plugin dbNSFP,/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/dbNSFP4.9a_grch38.gz,Ensembl_transcriptid,Uniprot_acc,VEP_canonical,LRT_pred,SIFT_pred,MutationTaster_pred,Polyphen2_HDIV_pred,Polyphen2_HVAR_pred,AlphaMissense_score,AlphaMissense_rankscore,AlphaMissense_pred,PrimateAI_score,PrimateAI_rankscore,PrimateAI_pred \
    --plugin Conservation,/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/release_114_gerp_conservation_scores.homo_sapiens.GRCh38.bw \
    --plugin EVE,file=/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/eve_merged.vcf.gz \
    --plugin Enformer,file=/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/enformer_grch38.vcf.gz \
    --plugin MaveDB,file=/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/MaveDB_variants.tsv.gz,cols=all \
    --plugin RiboseqORFs,file=/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/Ribo-seq_ORFs.bed.gz \
    --plugin BayesDel,file=/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/BayesDel_170824_addAF_all_scores_grch38.txt.gz \
    --plugin MPC,/lustre/scratch125/humgen/resources_v2/ensembl/vep/GRCh38/Plugins/mpc_scores.GRCH38.gnomad_v2.1.1.liftover.tsv.gz \
    """

    // =====================================================================
    // RESOURCE CEILINGS
    // Hard ceilings enforced by check_max() in nextflow.config — no task
    // will be allowed to request more than these, whatever a process asks
    // for. Set these to match your cluster's actual limits.
    // =====================================================================
    max_memory = "700.GB"
    max_cpus   = 64
    max_time   = "240.h"

    custom_config_version = 'master'
    custom_config_base    = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
}
